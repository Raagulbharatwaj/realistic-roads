<Project Sdk="Microsoft.NET.Sdk">

  <!-- Runs the mod's pure code (curve maths, road builder cross-sections) outside the game: dotnet test -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\RealisticRoads\CurveMath.cs" Link="CurveMath.cs" />
    <Compile Include="..\..\RealisticRoads\RoadConfig.cs" Link="RoadConfig.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.6.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.4" />
  </ItemGroup>

</Project>
